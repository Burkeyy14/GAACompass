# ── Browser (safe to expose) ─────────────────────────────
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Shown on the upgrade screen (just labels; the real prices live in Stripe)
VITE_PRICE_MONTHLY_LABEL=€3.99 / month
VITE_PRICE_YEARLY_LABEL=€29.99 / year

# ── Server only (Vercel → Settings → Environment Variables). NEVER prefix with VITE_ ──
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
APP_URL=https://your-app.vercel.app
# Comma-separated codes that unlock Pro for free (for beta testers)
BETA_CODES=DOORA2026,ULWOLVES
# Stripe (optional until you want to take payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...
